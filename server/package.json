{
	"name": "attire-server",
	"version": "1.0.0",
	"description": "Express server for attire inventory management",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node-dev --respawn --transpile-only src/index.ts",
		"dev:watch": "nodemon --exec ts-node src/index.ts",
		"bulk-import": "ts-node src/bulk-import.ts"
	},
	"dependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"better-sqlite3": "^12.2.0",
		"body-parser": "^1.20.2",
		"cors": "^2.8.5",
		"express": "^4.18.2",
		"multer": "^2.0.2"
	},
	"devDependencies": {
		"@types/body-parser": "^1.19.5",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.12.7",
		"nodemon": "^3.0.1",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.4.5"
	}
}
